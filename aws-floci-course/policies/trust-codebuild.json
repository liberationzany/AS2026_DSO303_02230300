{
    "Version": "2012-10-17",
    "Statement": [
       {
          "Sid": "CodeBuildAssumesThisRole",
          "Effect": "Allow",
          "Principal": { "Service": "codebuild.amazonaws.com" },
          "Action": "sts:AssumeRole",
          "Condition": {
             "StringEquals": { "aws:SourceAccount": "000000000000" }
          }
       }
    ]
}
